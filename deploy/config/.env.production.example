# IQRA — Production environment configuration (example/template)
# Copy to .env.production and fill in real values before deploying.
# NOTE: current build uses on-device Hive storage; these variables are
# placeholders for the future real backend/API and third-party services.

# ── Deployment target (matches --dart-define=IQRA_TARGET) ──────────
IQRA_TARGET=app                # app | studio | control | website

# ── Subdomains ───────────────────────────────────────────────────
APP_DOMAIN=iqra.nuerizo.com
STUDIO_DOMAIN=studio.iqra.nuerizo.com
CONTROL_DOMAIN=control.nuerizo.com
API_DOMAIN=api.iqra.nuerizo.com   # reserved, no backend deployed yet

# ── Firebase (only if/when Firebase is wired in — not active today) ─
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_WEB=

# ── Payments (simulated until real keys are added, per feature flags
#    payments.stripe / payments.razorpay) ───────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Push notifications (Firebase Cloud Messaging — architecture only
#    until credentials are added, per feature flag notifications.push) ─
FCM_SERVER_KEY=

# ── Android signing (already generated for this build) ─────────────
# See android/key.properties (git-ignored) and android/release-key.jks
ANDROID_KEYSTORE_PATH=android/release-key.jks
ANDROID_KEY_ALIAS=release

# ── Misc ─────────────────────────────────────────────────────────
SENTRY_DSN=
ANALYTICS_WRITE_KEY=
